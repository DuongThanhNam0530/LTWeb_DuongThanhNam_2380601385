<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebBanHang</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body>

    <!-- Top bar -->
    <div class="topbar d-none d-md-block">
        <span>✅ Sản phẩm chính hãng</span>
        <span>🔄 Đổi trả trong 7 ngày</span>
        <span>🚚 Miễn phí vận chuyển toàn quốc</span>
        <span>📞 Hotline: <strong>1900.xxxx</strong></span>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <div class="brand-icon">W</div>
                Web<span style="color:#ffd700;">BanHang</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <partial name="_LoginPartial" />
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">🏠 Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">📦 Sản phẩm</a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Add">➕ Thêm SP</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">🗂️ Danh mục</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Promo strip -->
    <div class="promo-strip">
        <div class="container-fluid">
            <div class="promo-item"><span>⚡</span> Flash sale mỗi ngày</div>
            <div class="promo-item"><span>🛡️</span> Bảo hành chính hãng</div>
            <div class="promo-item"><span>💳</span> Thanh toán linh hoạt</div>
            <div class="promo-item"><span>📦</span> Giao hàng nhanh 2h</div>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <p>© 2024 <a href="/">WebBanHang</a> — Thực hành Lập trình Web · ASP.NET Core MVC</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
