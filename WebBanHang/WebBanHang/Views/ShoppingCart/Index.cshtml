@model WebsiteBanHang.Models.ShoppingCart
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container mt-4">
    <h2><i class="bi bi-cart3"></i> Giỏ hàng của bạn</h2>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info mt-3">
            Giỏ hàng trống. <a asp-controller="Home" asp-action="Index">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl" style="width:50px;height:50px;object-fit:cover" class="me-2"/>
                            @item.Name
                        </td>
                        <td>@item.Price.ToString("#,##0") VNĐ</td>
                        <td>@item.Quantity</td>
                        <td>@((item.Price * item.Quantity).ToString("#,##0")) VNĐ</td>
                        <td>
                            <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId"
                               class="btn btn-sm btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <h4>Tổng cộng: <span class="text-danger fw-bold">@Model.GetTotalPrice().ToString("#,##0") VNĐ</span></h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">Tiếp tục mua</a>
            <a asp-action="Checkout" class="btn btn-success">Đặt hàng <i class="bi bi-arrow-right"></i></a>
        </div>
    }
</div>