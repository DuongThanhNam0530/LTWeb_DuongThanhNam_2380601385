@model WebsiteBanHang.Models.Order
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-4" style="max-width:600px">
    <h2><i class="bi bi-credit-card"></i> Thông tin đặt hàng</h2>

    <form asp-action="Checkout" method="post" class="mt-3" id="checkoutForm">
        <div class="mb-3">
            <label asp-for="ShippingAddress" class="form-label">Địa chỉ giao hàng <span class="text-danger">*</span></label>
            <input asp-for="ShippingAddress" class="form-control" placeholder="Nhập địa chỉ giao hàng..." id="shippingInput" />
            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Ghi chú</label>
            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú thêm..."></textarea>
        </div>

        <!-- Thông báo lỗi khi chưa nhập địa chỉ -->
        <div id="addressAlert" class="alert alert-danger d-none" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Vui lòng nhập địa chỉ giao hàng trước khi đặt hàng!
        </div>

        <button type="submit" class="btn btn-primary w-100" id="submitBtn">
            <i class="bi bi-bag-check"></i> Xác nhận đặt hàng
        </button>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('checkoutForm').addEventListener('submit', function (e) {
            const address = document.getElementById('shippingInput').value.trim();
            const alert = document.getElementById('addressAlert');

            if (!address) {
                e.preventDefault(); // chặn submit
                alert.classList.remove('d-none'); // hiện thông báo

                // Cuộn lên để thấy thông báo
                document.getElementById('shippingInput').focus();
                document.getElementById('shippingInput').style.borderColor = '#dc3545';
            } else {
                alert.classList.add('d-none');
                document.getElementById('shippingInput').style.borderColor = '';
            }
        });

        // Ẩn thông báo khi bắt đầu nhập
        document.getElementById('shippingInput').addEventListener('input', function () {
            if (this.value.trim()) {
                document.getElementById('addressAlert').classList.add('d-none');
                this.style.borderColor = '';
            }
        });
    </script>
}