@model IEnumerable<WebsiteBanHang.Models.Product>
@{
    ViewData["Title"] = "Home Page";
}
<div class="text-center">
    <h1 class="display-4">Chào Mừng</h1>
</div>
<section class="py-4">
    <div class="container">
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name"
                             style="height: 200px; object-fit:cover">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">@item.Name</h6>
                            <p class="text-danger fw-bold">@item.Price.ToString("#,##0") VNĐ</p>
                            <a asp-controller="ShoppingCart"
                               asp-action="AddToCart"
                               asp-route-productId="@item.Id"
                               asp-route-quantity="1"
                               class="btn btn-outline-dark btn-sm mt-auto">
                                <i class="bi-cart-fill me-1"></i> Thêm vào giỏ
                            </a>
                            <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline btn-sm">👁️ Xem</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
