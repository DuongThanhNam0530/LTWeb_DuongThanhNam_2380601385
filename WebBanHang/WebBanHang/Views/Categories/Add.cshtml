@model WebsiteBanHang.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục";
}

<div class="page-header">
    <h1 class="page-title">Thêm danh mục</h1>
    <a asp-action="Index" class="btn btn-outline">← Quay lại</a>
</div>

<div class="form-card">
    <form asp-action="Add">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="form-group">
            <label asp-for="Name" class="form-label">Tên danh mục *</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div style="margin-top:1rem;">
            <button type="submit" class="btn btn-accent">✅ Thêm</button>
            <a asp-action="Index" class="btn btn-outline">Hủy</a>
        </div>
    </form>
</div>